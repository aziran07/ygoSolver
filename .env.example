# Copy to .env (git-ignored, chmod 600) and replace with a random value, e.g.
#   openssl rand -hex 32
# Hex keeps the password safe inside the DATABASE_URL built by compose.yaml.
POSTGRES_PASSWORD=replace-with-random-hex
# Web app host binding (compose.yaml "web"). Defaults keep it on this host only;
# set the server's LAN address to serve the same network.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8501
