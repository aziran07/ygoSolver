# Runtime for the price_store.py CLI (PostgreSQL history + Redis cache).
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-prices.txt .
RUN pip install --no-cache-dir -r requirements-prices.txt \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin prices
COPY prices.py price_store.py ./

USER prices
ENTRYPOINT ["python", "price_store.py"]
