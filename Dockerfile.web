# Runtime for the Streamlit deck-photo web app (app.py).
# Runtime data (models, references, official card DB, caches) is bind-mounted
# by compose.yaml; nothing under data/ is baked into the image.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin app
COPY app.py card_prices.py catalog.py deck_order.py exports.py price_collector.py price_store.py prices.py rarities.py \
     recognition.py references.py ./
COPY .streamlit/config.toml .streamlit/config.toml
COPY THIRD_PARTY_NOTICES.md ./
COPY LICENSES/ LICENSES/

USER app
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4).read() == b'ok' else 1)"]
# The tracked config.toml binds to localhost for the Windows desktop run;
# inside the container the server must listen on all interfaces so the
# published port reaches it. Upload limit and telemetry come from config.toml.
ENTRYPOINT ["streamlit", "run", "app.py", "--server.headless=true", "--server.address=0.0.0.0", "--server.port=8501"]
